# LLM provider: deepseek | kimi | openai | custom
LLM_PROVIDER=deepseek

# Keep the real key only in .env.local or the server secret manager.
LLM_API_KEY=

# Optional overrides. Provider defaults are used when left blank.
# DeepSeek: https://api.deepseek.com / deepseek-v4-flash
# Kimi: https://api.moonshot.cn/v1 / kimi-k2.6
LLM_BASE_URL=
LLM_MODEL=

# disabled is faster and more predictable for structured JSON; enable only after evaluation.
LLM_THINKING=disabled
LLM_TIMEOUT_MS=30000
