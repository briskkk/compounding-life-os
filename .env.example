# Product brand shown in the header and browser title. Default: Compound Life.
# BRAND_NAME=Compound Life
# BRAND_NAME_EN=Compound Life

# Public product information archive (contains no household amounts/accounts)
# PRODUCT_INFORMATION_CACHE_DIR=/absolute/path/product-information

# Optional creator export: absolute path to an operator-approved private JSON config.
# Unset by default; dedicated scoped credentials only. See docs/creator-daily-snapshots.md.
# CREATOR_EXPORT_CONFIG_PATH=/absolute/private/path/creator-export.json
