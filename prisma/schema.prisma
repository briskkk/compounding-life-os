generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---------- 家庭空间与成员 ----------

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ReviewStatus {
  DRAFT
  COMPLETED
}

// 账号：能登录的人（email + 密码哈希），不属于任何家庭
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  /**
   * 用户偏好（JSON）：如默认收益区间
   */
  preferences  String?
  members      Member[]
  sessions     Session[]
}

// 会话：双通道（网页 httpOnly cookie / APP Bearer token 共用 token 字段）
model Session {
  id        String   @id @default(cuid())
  userId    String
  familyId  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// 家庭邀请码：OWNER 生成，受邀者注册或登录后凭码加入家庭
model Invite {
  id        String   @id @default(cuid())
  familyId  String
  code      String   @unique
  role      Role     @default(MEMBER)
  expiresAt DateTime
  createdBy String
  createdAt DateTime @default(now())

  @@index([familyId])
}

model FamilySpace {
  id                String             @id @default(cuid())
  name              String
  baseCurrency      String             @default("CNY")
  createdAt         DateTime           @default(now())
  members           Member[]
  accounts          Account[]
  assets            Asset[]
  transactions      Transaction[]
  liabilities       Liability[]
  liabilityEntries  LiabilityEntry[]
  goals             Goal[]
  savingsEntries    SavingsEntry[]
  snapshots         Snapshot[]
  portfolioReviews  PortfolioReview[]
  importBatches     ImportBatch[]
  allocationTargets AllocationTarget[]
  cashPlans         CashPlan[]
  corporateActions  CorporateAction[]
  fundTradePolicies FundTradePolicy[]
  auditLogs         AuditLog[]
}

model Member {
  id        String      @id @default(cuid())
  familyId  String
  family    FamilySpace @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      Role        @default(MEMBER)
  createdAt DateTime    @default(now())

  @@index([familyId])
  @@index([userId])
}

// ---------- 账户与资产 ----------

enum AccountType {
  BROKERAGE
  BANK
  FUND
  PROPERTY
  OTHER
}

model Account {
  id                  String        @id @default(cuid())
  familyId            String
  family              FamilySpace   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name                String
  type                AccountType   @default(OTHER)
  institution         String?
  currency            String        @default("CNY")
  settlementAccountId String?
  settlementAccount   Account?      @relation("AccountSettlement", fields: [settlementAccountId], references: [id], onDelete: SetNull)
  settlementFor       Account[]     @relation("AccountSettlement")
  note                String?
  createdAt           DateTime      @default(now())
  transactions        Transaction[]
  corporateActions    CorporateAction[] @relation("CorporateActionSourceAccount")
  targetActions       CorporateAction[] @relation("CorporateActionTargetAccount")
  cashPlans           CashPlan[]

  @@unique([familyId, name])
  @@index([familyId])
  @@index([settlementAccountId])
}

enum AssetClass {
  STOCK
  FUND
  ETF
  CASH
  GOLD
  REAL_ESTATE
  HUAWEI_STOCK
}

enum AssetStyle {
  GROWTH
  VALUE
  BALANCED
  QUANT
  SECTOR_THEME
  BROAD_INDEX
  SECTOR_INDEX
}

model Asset {
  id           String        @id @default(cuid())
  familyId     String
  family       FamilySpace   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  symbol       String
  name         String
  cls          AssetClass
  style        AssetStyle? // 投资风格（仅行情类资产；null = 未分类）
  manual       Boolean       @default(false) // 手动估值资产（房产等）
  currency     String        @default("CNY")
  tags         String        @default("") // 自定义分组标签，逗号分隔（如 "美元基金,长期"）
  note         String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  corporateActions CorporateAction[] @relation("CorporateActionSourceAsset")
  targetActions    CorporateAction[] @relation("CorporateActionTargetAsset")
  fundTradePolicy  FundTradePolicy?

  @@unique([familyId, symbol])
  @@index([familyId])
}

// 基金交易规则只保存平台披露与用户核验的操作参数；不会替代账本流水或官方净值。
model FundTradePolicy {
  id                     String      @id @default(cuid())
  familyId               String
  family                 FamilySpace @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assetId                String      @unique
  asset                  Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  purchaseFeeRate        Float       @default(0)
  redemptionFeeRules     String      @default("[]")
  purchaseSuspendedFrom  DateTime?
  purchaseSuspendedUntil DateTime?
  sourceName             String
  sourceReference        String?
  note                   String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([familyId])
}

// ---------- 唯一事实源：交易流水 ----------

enum TxType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  FEE
  DEPOSIT
  WITHDRAW
  TRANSFER_IN
  TRANSFER_OUT
  VALUATION
  VEST
  SHARE_ADJUSTMENT
  COST_ADJUSTMENT
  REVERSAL
}

model Transaction {
  id                String       @id @default(cuid())
  familyId          String
  family            FamilySpace  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type              TxType
  quantity          Decimal?
  price             Decimal?
  amount            Decimal      @default(0)
  fee               Decimal      @default(0)
  occurredAt        DateTime
  navDate           DateTime? // 基金确认净值日（申购/赎回份额按该日净值确认；缺省 = occurredAt）
  navSource         String? // 净值来源：OFFICIAL 官方净值 / ESTIMATE 盘中估算（缺省 null = 手工录入）
  settlementDate    DateTime? // 预计资金到账日（基金赎回在途；缺省 = occurredAt 即时结算）
  note              String?
  internal          Boolean      @default(false) // 内部结算腿（买卖联动现金、转账），不计入外部投入
  voidedAt          DateTime? // 被冲正后标记，账本折叠时跳过
  reversalOfId      String? // REVERSAL 流水指向被冲正的原始流水
  settleOfId        String? // 结算腿指向其主流水（冲正时联动作废）
  importBatchId     String? // CSV 导入批次；手工/API 录入为 null
  importBatch       ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importRowHash     String? // 跨文件逐行幂等指纹；手工/API 流水为 null
  corporateActionId String? // 公司行动证据包；持仓影响仍由本流水重放
  corporateAction   CorporateAction? @relation(fields: [corporateActionId], references: [id], onDelete: SetNull)
  clientRequestId   String? // APP 写入幂等键（Idempotency-Key）
  clientRequestHash String? // 同键不同请求体时拒绝复用
  createdAt         DateTime     @default(now())

  @@unique([familyId, clientRequestId])
  @@unique([familyId, importRowHash])
  @@index([familyId, occurredAt])
  @@index([familyId, assetId])
  @@index([importBatchId])
  @@index([corporateActionId])
}

model ImportBatch {
  id            String        @id @default(cuid())
  familyId      String
  family        FamilySpace   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contentHash   String
  sourceName    String?
  rowCount      Int
  importedCount Int
  failedCount   Int
  duplicateCount Int          @default(0)
  settleCash    Boolean       @default(false)
  totalAmount   Decimal       @default(0)
  totalFees     Decimal       @default(0)
  issuesJson    String        @default("[]")
  mappingJson   String        @default("{}")
  createdBy     String
  createdAt     DateTime      @default(now())
  transactions  Transaction[]

  @@unique([familyId, contentHash])
  @@index([familyId, createdAt])
}

enum CorporateActionType {
  SPLIT
  REVERSE_SPLIT
  STOCK_DIVIDEND
  RIGHTS_ISSUE
  SYMBOL_CHANGE
  MERGER_EXCHANGE
  SPINOFF
  CUSTODY_TRANSFER
  CASH_DISTRIBUTION
  FUND_REINVESTMENT
}

// 公司行动只保存事件证据与生成关系；数量、成本和现金仍由关联 Transaction 重放。
model CorporateAction {
  id               String              @id @default(cuid())
  familyId         String
  family           FamilySpace         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account             @relation("CorporateActionSourceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  targetAccountId  String?
  targetAccount    Account?            @relation("CorporateActionTargetAccount", fields: [targetAccountId], references: [id], onDelete: SetNull)
  assetId          String
  asset            Asset               @relation("CorporateActionSourceAsset", fields: [assetId], references: [id], onDelete: Cascade)
  targetAssetId    String?
  targetAsset      Asset?              @relation("CorporateActionTargetAsset", fields: [targetAssetId], references: [id], onDelete: SetNull)
  type             CorporateActionType
  effectiveAt      DateTime
  ratioNumerator   Decimal?
  ratioDenominator Decimal?
  quantityBefore   Decimal?
  quantityAfter    Decimal?
  cashAmount       Decimal             @default(0)
  fee              Decimal             @default(0)
  costAllocation   Float?
  sourceName       String?
  sourceReference  String?
  note             String?
  reversedAt       DateTime?
  createdBy        String
  createdAt        DateTime            @default(now())
  transactions     Transaction[]

  @@index([familyId, effectiveAt])
  @@index([accountId, assetId])
  @@index([targetAccountId])
  @@index([targetAssetId])
}

// ---------- 负债 ----------

enum LiabilityType {
  MORTGAGE
  CAR_LOAN
  CONSUMER
  OTHER
}

model Liability {
  id        String           @id @default(cuid())
  familyId  String
  family    FamilySpace      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  type      LiabilityType    @default(MORTGAGE)
  rate      Float? // 年利率，如 0.042
  note      String?
  createdAt DateTime         @default(now())
  entries   LiabilityEntry[]

  @@index([familyId])
}

enum LiabilityEntryType {
  DRAW
  REPAY
  ADJUST
}

model LiabilityEntry {
  id          String             @id @default(cuid())
  familyId    String
  family      FamilySpace        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  liabilityId String
  liability   Liability          @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  type        LiabilityEntryType
  amount      Decimal
  occurredAt  DateTime
  note        String?
  createdAt   DateTime           @default(now())

  @@index([familyId, occurredAt])
}

// ---------- 目标 / 快照 / 审计 ----------

enum GoalMetric {
  NET_WORTH
  INVESTABLE
}

enum GoalMode {
  LUMP_SUM
  STREAM
}

enum SavingsPeriod {
  WEEK
  MONTH
}

model SavingsEntry {
  id          String        @id @default(cuid())
  familyId    String
  family      FamilySpace   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  periodType  SavingsPeriod
  periodStart DateTime
  income      Decimal       @default(0)
  spending    Decimal       @default(0)
  savedAmount Decimal       @default(0)
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([familyId, periodType, periodStart])
  @@index([familyId, periodStart])
}

model Goal {
  id                  String      @id @default(cuid())
  familyId            String
  family              FamilySpace @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name                String
  mode                GoalMode    @default(LUMP_SUM) // FIRE：LUMP_SUM 直接设 FIRE Number / STREAM 按退休支出反推
  targetAmount        Decimal
  targetDate          DateTime
  annualSpend         Decimal? // STREAM：今日购买力口径的年度退休支出
  spendYears          Int? // 退休资金规划年数
  retirementIncome    Decimal     @default(0) // 今日购买力口径的年度稳定退休收入
  withdrawalRate      Float       @default(0.04) // 初始安全提取率
  inflationRate       Float       @default(0.025) // 长期年化通胀假设
  metric              GoalMetric  @default(INVESTABLE)
  monthlyContribution Decimal     @default(0)
  expectedReturn      Float       @default(0.07)
  volatility          Float       @default(0.15)
  note                String?
  createdAt           DateTime    @default(now())

  @@index([familyId])
}

// 用户设定的资产大类目标；只用于偏离观察，不产生交易或可写余额。
model AllocationTarget {
  id           String      @id @default(cuid())
  familyId     String
  family       FamilySpace @relation(fields: [familyId], references: [id], onDelete: Cascade)
  cls          AssetClass
  targetWeight Float
  tolerance    Float       @default(0.03)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([familyId, cls])
  @@index([familyId])
}

enum CashPlanDirection {
  INFLOW
  OUTFLOW
  MILESTONE
}

enum CashPlanRecurrence {
  NONE
  MONTHLY
  YEARLY
}

// 未来现金安排；属于计划层，不计入账本、净资产或收益。
model CashPlan {
  id         String             @id @default(cuid())
  familyId   String
  family     FamilySpace        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  accountId  String?
  account    Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  title      String
  direction  CashPlanDirection
  amountCny  Decimal            @default(0)
  dueDate    DateTime
  recurrence CashPlanRecurrence @default(NONE)
  endDate    DateTime?
  note       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([familyId, dueDate])
  @@index([accountId])
}

model Snapshot {
  id                  String      @id @default(cuid())
  familyId            String
  family              FamilySpace @relation(fields: [familyId], references: [id], onDelete: Cascade)
  date                DateTime
  assets              Decimal     @default(0) // 总资产（未扣负债）
  liabilities         Decimal     @default(0) // 总负债
  netWorth            Decimal // = assets − liabilities
  investable          Decimal // 可自由投资口径
  contributions       Decimal     @default(0) // 累计净投入（外部现金流）
  valuationStatus     String      @default("LEGACY") // SETTLED / PARTIAL / CLOSED / NO_UPDATE / FLOW_ONLY
  valuationCoverage   Float? // 获得估值日新价格的行情资产市值占比
  freshValue          Decimal     @default(0) // 当日获得新价格的行情资产市值
  pricedValue         Decimal     @default(0) // 行情类可投资资产市值
  latestValuationDate DateTime? // 本快照所含最新估值日期
  valuationDetails    String      @default("[]") // JSON：沿用旧价格或缺价格的资产
  createdAt           DateTime    @default(now())

  @@unique([familyId, date])
}

model PortfolioReview {
  id              String       @id @default(cuid())
  familyId        String
  family          FamilySpace  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId        String
  authorName      String
  period          String
  startDate       DateTime
  endDate         DateTime
  status          ReviewStatus @default(DRAFT)
  note            String       @default("")
  metricsSnapshot String       @default("{}")
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([familyId, period, startDate])
  @@index([familyId, updatedAt])
}

model AuditLog {
  id          String       @id @default(cuid())
  familyId    String?
  family      FamilySpace? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actorId     String?
  actorName   String
  action      String
  entity      String
  entityId    String?
  detail      String?
  hash        String
  hashVersion Int          @default(1)
  prevHash    String?
  chainScope  String? // familyId / __GLOBAL__；旧记录为空，兼容迁移
  chainKey    String? // 新写入为 prevHash / GENESIS；旧记录为空，唯一约束阻止同一父节点产生两个后继
  createdAt   DateTime     @default(now())

  @@unique([chainScope, chainKey])
  @@index([familyId, createdAt])
}

// ---------- 行情历史（全局共享，无 familyId，不参与 RLS） ----------

model PriceBar {
  id     String   @id @default(cuid())
  symbol String
  date   DateTime
  close  Decimal
  source String   @default("SIMULATED")

  @@unique([symbol, date])
  @@index([symbol])
}

// 行情调用的日度可观测证据；全局数据，不绑定某个家庭，也不参与估值计算。
model MarketProviderDaily {
  id          String   @id @default(cuid())
  provider    String
  scope       String
  date        DateTime
  requests    Int      @default(0)
  ok          Int      @default(0)
  failed      Int      @default(0)
  totalMs     Int      @default(0)
  lastError   String?
  lastErrorAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, scope, date])
  @@index([date])
}

// 历史外汇汇率（全局共享，无 familyId，不参与 RLS）：按 (pair, date) 唯一
// pair = USDCNY / HKDCNY；快照重建按当日汇率折算，缺失回落最近可用
model RateBar {
  id     String   @id @default(cuid())
  pair   String // USDCNY / HKDCNY
  date   DateTime
  rate   Decimal // 1 单位外币 = ? 人民币
  source String   @default("SINA")

  @@unique([pair, date])
  @@index([pair])
}

// 基金盘中估值采集（内部估值引擎输出，分钟级去重）
model FundEstimate {
  id             String   @id @default(cuid())
  symbol         String
  estimateReturn Float // 估算涨跌幅（小数）
  estimatedNav   Decimal // 估算净值
  confidence     Float // 置信度 0-1（前十大持仓覆盖率）
  detail         String? // 贡献分解 JSON
  createdAt      DateTime @default(now())

  @@index([symbol, createdAt])
}

// 估值校准：每日估算涨幅 vs 官方净值涨幅的误差记录
model FundCalibration {
  id             String   @id @default(cuid())
  symbol         String
  date           DateTime // 官方净值日期
  estReturn      Float // 当日最后一条估算涨幅（小数）
  officialReturn Float // 官方净值当日涨幅（小数）
  error          Float // estReturn − officialReturn
  createdAt      DateTime @default(now())

  @@unique([symbol, date])
}
