{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "家庭财富终端",
  "version": "0.1.0",
  "identifier": "com.huayanpei.family-wealth",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:31420",
    "beforeDevCommand": "node scripts/dev-server.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
