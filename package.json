{
  "name": "family-wealth-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "MARKET_PROVIDER=tencent,eastmoney-fund,sina next dev",
    "safe:dev": "./scripts/start-safe.sh dev",
    "build": "next build",
    "start": "MARKET_PROVIDER=tencent,eastmoney-fund,sina next start",
    "safe:start": "./scripts/start-safe.sh production",
    "safe:stop": "./scripts/start-safe.sh stop",
    "safe:status": "./scripts/start-safe.sh status",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:init": "tsx scripts/init-empty.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "next": "^15.3.0",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
