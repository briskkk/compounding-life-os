{
  "name": "family-wealth-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev MARKET_PROVIDER=tencent,eastmoney-kline,eastmoney-fund,sina next dev",
    "safe:dev": "./scripts/start-safe.sh dev",
    "build": "NEXT_DIST_DIR=.next next build",
    "start": "NEXT_DIST_DIR=.next MARKET_PROVIDER=tencent,eastmoney-kline,eastmoney-fund,sina next start",
    "build:e2e": "NEXT_DIST_DIR=.next-e2e next build",
    "start:e2e": "NEXT_DIST_DIR=.next-e2e DATABASE_URL=file:prisma/e2e.db MARKET_PROVIDER=simulated next start",
    "safe:start": "./scripts/start-safe.sh production",
    "safe:stop": "./scripts/start-safe.sh stop",
    "safe:status": "./scripts/start-safe.sh status",
    "test": "vitest run",
    "test:e2e": "npm run db:e2e && npm run build:e2e && playwright test",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:e2e": "node scripts/prepare-e2e.mjs",
    "db:init": "tsx scripts/init-empty.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:rehearse-postgres": "bash scripts/rehearse-postgres-contract.sh",
    "postinstall": "prisma generate",
    "auth:migrate": "tsx scripts/migrate-auth.ts",
    "auth:set-password": "tsx scripts/set-password.ts",
    "auth:cleanup": "tsx scripts/cleanup-sessions.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@prisma/client": "^6.6.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "next": "^15.3.0",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "undici": "^6.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
